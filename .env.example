# Port the server listens on
PORT=3000

# Your real GoHighLevel inbound webhook URL (kept on the server, never sent to the browser)
GHL_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/REPLACE_ME

# ---- Sign-in ----
# Who may create an account: full emails and/or whole domains, comma-separated.
# Example: ALLOWED_EMAILS=sandy@kam-team.com,@kam-team.com
# If blank, only the very first account can be created (the owner).
ALLOWED_EMAILS=

# Long random string used to sign login cookies. Keep it secret and don't change it,
# or everyone gets signed out. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# How many days a sign-in lasts (default 7)
# SESSION_DAYS=7

# Where accounts are stored. Set DATABASE_URL to use Postgres (recommended on hosts
# without a persistent disk, like Render's free plan). Otherwise accounts go in DATA_DIR/users.json.
DATABASE_URL=
# DATA_DIR=./data

# ---- Relay ----
# Extra browser origins allowed to call /api/ghl (comma-separated). Usually blank.
ALLOWED_ORIGINS=

# Optional shared secret so outside tools (not the app) can call /api/ghl with an X-API-Key header.
API_KEY=

# Optional limits
# RATE_LIMIT_PER_MIN=60
# AUTH_ATTEMPTS_PER_15_MIN=20
