# Port the server listens on
PORT=3000

# Your real GoHighLevel inbound webhook URL (kept on the server, never sent to the browser)
GHL_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/REPLACE_ME

# Extra browser origins allowed to call /api/ghl (comma-separated).
# The app's own origin is always allowed; leave blank if you only use the built-in page.
ALLOWED_ORIGINS=

# Optional shared secret. If set, enter the same value under Settings → GoHighLevel → Relay API key.
API_KEY=

# Optional: max relay requests per IP per minute (default 60)
# RATE_LIMIT_PER_MIN=60
