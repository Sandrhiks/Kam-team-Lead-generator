# Port the server listens on
PORT=3000

# ---- Sign-in (email one-time codes) ----
# Who may create an account: full emails and/or whole domains, comma-separated, or * for anyone.
# Example: ALLOWED_EMAILS=sandy@kam-team.com,@kam-team.com
# If blank, only the very first account can be created (the owner).
ALLOWED_EMAILS=

# Long random string that signs sign-in cookies and sign-in codes. Keep it secret and don't change it,
# or everyone gets signed out. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# How sign-in codes are emailed. Set ONE of these:
# 1) Resend (https://resend.com): API key + a sender on a domain you verified there
RESEND_API_KEY=
MAIL_FROM=Kam Team Design Studio <studio@kam-team.com>
# 2) Your own webhook (GoHighLevel, n8n, Zapier...). It receives JSON {to, subject, text, html, code} and sends the email.
MAIL_WEBHOOK_URL=
# With neither, codes are printed in the server log (only allowed when NODE_ENV isn't production).

# Minutes a sign-in code stays valid (default 10) and days a sign-in lasts (default 7)
# OTP_MINUTES=10
# SESSION_DAYS=7

# ---- Storage ----
# Postgres connection string (recommended on hosts without a persistent disk, like Render's free plan).
# Otherwise everything is stored as JSON files in DATA_DIR.
DATABASE_URL=
# DATA_DIR=./data

# ---- AI ----
# Anthropic API key for the AI design agent and the Assistant chat (console.anthropic.com).
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
# Optional: OpenAI API key to generate photos and illustrations inside the studio.
OPENAI_API_KEY=
# IMAGE_MODEL=gpt-image-1

# ---- Support ----
# Where support tickets are emailed, and shown to users as a contact address. Optional.
SUPPORT_EMAIL=

# ---- Limits (optional) ----
# AI_MESSAGES_PER_10_MIN=40
# IMAGES_PER_HOUR=30
# CODE_REQUESTS_PER_15_MIN=10
# VERIFY_ATTEMPTS_PER_15_MIN=30
