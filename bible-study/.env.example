# Kam Team Bible Study Guide — copy to bible-study/.env

PORT=3100

# Signs sign-in cookies. Use a long random value and keep it the same.
SESSION_SECRET=

# How long a sign-in lasts, in days.
SESSION_DAYS=30

# Who may create an account: * for anyone, or a list such as pastor@church.org,@church.org
ALLOWED_EMAILS=*

# Postgres (recommended in production). Leave empty to use JSON files in DATA_DIR.
DATABASE_URL=
# DATA_DIR=./bible-study/data

# Web Push keys. Generate with:
#   node -e "console.log(require('./bible-study/lib/push').generateVapidKeys())"
# Left empty, a pair is generated once and kept in the database (or DATA_DIR/meta.json).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:team@kam-team.com
